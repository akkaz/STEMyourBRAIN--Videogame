{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babilonia-api",
  "main": "cf-worker/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "BabiloniaApi",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API_CONTAINER", "class_name": "BabiloniaApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BabiloniaApi"] }
  ],
  "observability": { "enabled": true }
}
